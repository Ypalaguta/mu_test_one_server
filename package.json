{
  "name": "mu-game-data-api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "seed:static": "node --env-file=.env --import tsx src/seed/run.ts static",
    "seed:dev": "node --env-file=.env --import tsx src/seed/run.ts dev",
    "seed:check": "node --import tsx src/seed/check.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "seed:skills": "node --env-file=.env --import tsx src/seed/run.ts skills"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongoose": "^9.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
